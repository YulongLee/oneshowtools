APP_URL=http://localhost:5173
API_PORT=8787
API_HOST=0.0.0.0
DATA_DIR=data
MAX_UPLOAD_BYTES=26214400
REGISTRATION_ENABLED=false
ALLOW_DEV_EMAIL_DELIVERY=true
BILLING_ENABLED=false
ACCOUNT_DELETION_ENABLED=false
# Comma-separated, verified user emails allowed to access /admin.
ADMIN_EMAILS=
ADMIN_RBAC_ENABLED=true
ADMIN_MFA_ENFORCED=false
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_CREDIT_APPROVAL_THRESHOLD=1000
ADMIN_CUSTOMER_OPERATIONS_ENABLED=true
ADMIN_COMMERCIAL_OPERATIONS_ENABLED=true
ADMIN_TOOL_GOVERNANCE_ENABLED=true
ADMIN_PRIVACY_OPERATIONS_ENABLED=true
ADMIN_OBSERVABILITY_ENABLED=true
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtpdm.aliyun.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=noreply@mail.oneshowtools.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=OneShowTools <noreply@mail.oneshowtools.com>
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=

# Managed model identity is private; the UI exposes only "OneShowModel".
ONESHOW_MODEL_API_KEY=
ONESHOW_MODEL_BASE_URL=
ONESHOW_MODEL_ID=
ONESHOW_MODEL_EXECUTION_ENABLED=false
MODEL_CONNECTIONS_ENABLED=false
MODEL_CREDENTIAL_ENCRYPTION_KEY=
DURABLE_WORKER_ENABLED=true
MODEL_REQUEST_TIMEOUT_MS=45000
WORKER_POLL_MS=500

# OneShowSEO scheduled live crawls. Manual recommendations need no write
# access. Optional automatic changes use an owner-provided CMS webhook and a
# separate 32-byte base64/hex key (or MODEL_CREDENTIAL_ENCRYPTION_KEY).
SEO_AGENT_SCHEDULER_ENABLED=true
SEO_AGENT_POLL_MS=300000
SEO_AGENT_CREDENTIAL_ENCRYPTION_KEY=

# Private object storage for user uploads. OFFERSTEADY_OSS_* aliases are also
# supported. New objects are written beneath OSS_KEY_PREFIX with random IDs;
# existing bucket objects are never listed or overwritten.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_REGION=
OSS_KEY_PREFIX=oneshowtools

# Internal development executor. It is never exposed in the customer model UI.
# Point CODEX_WORKSPACE_ROOT at a dedicated Git workspace without production
# .env files, credentials, uploads, or database files.
CODEX_EXECUTOR_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_MODEL=qwen3.6-flash
# Optional aliases already supported from the supplied environment:
# OFFERSTEADY_DASHSCOPE_API_KEY, OFFERSTEADY_CHAT_QWEN_BASE_URL,
# OFFERSTEADY_CHAT_MODEL.
CODEX_MODEL=
CODEX_BASE_URL=
CODEX_REASONING_EFFORT=medium
CODEX_WORKSPACE_ROOT=
CODEX_EXECUTOR_TIMEOUT_MS=1200000
# Use this for OpenAI-compatible providers that expose Chat Completions but not
# the full Responses streaming protocol. It applies only to read-only analysis.
CODEX_ANALYSIS_TRANSPORT=chat-completions

# Admin-only daily market intelligence. External sources are collected by the
# server; Codex receives only sanitized evidence and persisted platform metrics.
MARKET_INTELLIGENCE_ENABLED=true
MARKET_INTELLIGENCE_MODEL=kimi/kimi-k3
# Optional server-side fallback when the Alibaba Cloud account has not enabled
# the preferred model yet. The actual model used is stored on each report.
MARKET_INTELLIGENCE_FALLBACK_MODEL=
MARKET_INTELLIGENCE_SCHEDULE=08:00
MARKET_INTELLIGENCE_POLL_MS=900000
# Public-source rate-limit upgrade (optional; repository and issue search work
# without it at lower limits).
GITHUB_TOKEN=
# Authorized intelligence sources. Credentials remain server-side and their
# values are never returned by the admin API.
PRODUCT_HUNT_TOKEN=
YOUTUBE_API_KEY=
# China-market sources use official public RSS/API feeds. These optional tokens
# unlock Gitee search and authenticated V2EX API access.
GITEE_ACCESS_TOKEN=
V2EX_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://oneshowtools.com/
# Prefer refresh-token OAuth for unattended daily Search Console / Google Ads
# collection. GOOGLE_OAUTH_ACCESS_TOKEN is supported only for short tests.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_LANGUAGE_ID=1000
GOOGLE_ADS_GEO_TARGET_ID=2840
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
# Optional short-lived development alternatives:
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
REDDIT_ACCESS_TOKEN=

# Optional independent tool runtimes.
TOOL_RUNTIME_BASE_URL=
TOOL_RUNTIME_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
