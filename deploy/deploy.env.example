# Copy this file to .deploy.env. It contains deployment coordinates only;
# application credentials remain in /etc/oneshowtools/oneshowtools.env.
DEPLOY_HOST=47.101.208.144
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_SSH_KEY=/absolute/path/to/id_ed25519_oneshowtools_server

DEPLOY_APP_ROOT=/var/www/oneshowtools
DEPLOY_SERVICE=oneshowtools
DEPLOY_NODE_ROOT=/opt/node-v22
DEPLOY_HEALTH_URL=http://127.0.0.1:8787/api/health
DEPLOY_KEEP_RELEASES=3
DEPLOY_KEEP_DB_BACKUPS=3

# Run build, tests, and migration validation before uploading a release.
DEPLOY_SKIP_LOCAL_VERIFY=false

# Fresh Ubuntu only: set these values once to bootstrap the server and deploy in
# the same command. DNS for both the root domain and www must already point to
# DEPLOY_HOST. The environment file stays outside Git and is copied over SSH.
DEPLOY_BOOTSTRAP=false
DEPLOY_DOMAIN=oneshowtools.com
DEPLOY_LETSENCRYPT_EMAIL=
DEPLOY_ENV_FILE=/absolute/path/to/oneshowtools.production.env
