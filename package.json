{
  "name": "oneshowtools-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "node server/index.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "db:backup": "node scripts/backup-and-check.mjs",
    "openspec:validate": "openspec validate add-global-auth-and-billing --strict"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.146.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "ali-oss": "^6.23.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12"
  }
}
