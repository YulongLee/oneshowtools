{
  "name": "oneshowtools-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "node server/index.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "build:mobile": "npm --prefix apps/mobile run check",
    "build:miniprogram": "npm --prefix apps/miniprogram run build:weapp",
    "build:clients": "npm run build:mobile && npm run build:miniprogram",
    "check:stock-pet": "npm --prefix apps/stock-pet run check",
    "build:stock-pet": "npm --prefix apps/stock-pet run build",
    "publish:stock-pet": "node scripts/publish-stock-pet-release.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "db:backup": "node scripts/backup-and-check.mjs",
    "deploy:prod": "bash deploy/one-click.sh",
    "deploy:rollback": "bash deploy/rollback.sh",
    "openspec:validate": "openspec validate add-global-auth-and-billing --strict"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@napi-rs/canvas": "^1.0.3",
    "@openai/codex-sdk": "^0.146.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "ali-oss": "^6.23.0",
    "better-auth": "^1.6.25",
    "cheerio": "^1.1.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "tesseract.js": "^7.0.0",
    "vite": "^6.4.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.25"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
